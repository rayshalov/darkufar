{
  "manifest_version": 3,
  "name": "Darkufar — Тёмная тема для Куфара",
  "short_name": "Darkufar",
  "version": "1.1.0",
  "description": "Тёмная тема и блокировщик рекламы для kufar.by. Включается одним кликом. Защищает глаза и убирает надоедливые баннеры.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Darkufar — Тёмная тема"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.kufar.by/*",
        "*://kufar.by/*"
      ],
      "js": [
        "content/content.js",
        "content/adblock.js"
      ],
      "css": [
        "content/dark-theme.css",
        "content/adblock.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.kufar.by/*",
    "*://kufar.by/*"
  ]
}
